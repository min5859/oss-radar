# GitHub Search API read token. Keep this separate from Wiki write credentials.
GITHUB_TOKEN=

# Fine-grained credential restricted to the oss-radar repository and Wiki write.
GITHUB_WIKI_TOKEN=
OSS_RADAR_WIKI_URL=https://github.com/min5859/oss-radar.wiki.git

# Headless Cursor Agent auth. Omit when `agent login` already created a session.
CURSOR_API_KEY=
